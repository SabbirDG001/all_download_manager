{
  "manifest_version": 3,
  "name": "All Download Manager",
  "version": "0.1.0",
  "description": "Sends your downloads to the All Download Manager app for faster, resumable downloads.",
  "key": "",
  "minimum_chrome_version": "110",
  "permissions": ["downloads", "nativeMessaging", "contextMenus", "storage", "cookies"],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "background.js" },
  "action": {
    "default_title": "All Download Manager",
    "default_popup": "popup.html",
    "default_icon": { "16": "icons/16.png", "32": "icons/32.png" }
  },
  "icons": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" }
}
