{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "All Download Manager",
  "mainBinaryName": "AllDownloadManager",
  "version": "0.1.0",
  "identifier": "com.sabbirdg001.alldownloadmanager",
  "build": {
    "frontendDist": "./ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "All Download Manager",
        "width": 1040,
        "height": 640,
        "minWidth": 760,
        "minHeight": 420,
        "dragDropEnabled": false,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "publisher": "SabbirDG001",
    "shortDescription": "Fast download manager",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      },
      "nsis": {
        "installMode": "both",
        "displayLanguageSelector": false,
        "installerHooks": "./windows/hooks.nsh"
      }
    },
    "resources": {
      "../../extension/": "extension/"
    }
  }
}
